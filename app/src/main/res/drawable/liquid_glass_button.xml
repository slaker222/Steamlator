<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <gradient
                        android:startColor="#48ffffff"
                        android:endColor="#28ffffff"
                        android:angle="270" />
                    <corners android:radius="18dp" />
                    <stroke android:width="1.5dp" android:color="#80ffffff" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape>
                    <gradient
                        android:type="radial"
                        android:gradientRadius="150dp"
                        android:startColor="#2099ddff"
                        android:endColor="#0099ddff" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient
                        android:startColor="#32ffffff"
                        android:endColor="#12ffffff"
                        android:angle="270" />
                    <corners android:radius="18dp" />
                    <stroke android:width="1.5dp" android:color="#50ffffff" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape>
                    <gradient
                        android:type="radial"
                        android:gradientRadius="150dp"
                        android:startColor="#1066c0ff"
                        android:endColor="#0066c0ff" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
