<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <gradient
                        android:startColor="#40ffffff"
                        android:endColor="#20ffffff"
                        android:angle="270" />
                    <corners android:radius="0dp" />
                    <stroke android:width="1dp" android:color="#70ffffff" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape>
                    <gradient
                        android:type="radial"
                        android:gradientRadius="120dp"
                        android:startColor="#1699ddff"
                        android:endColor="#0099ddff" />
                    <corners android:radius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <gradient
                        android:startColor="#28ffffff"
                        android:endColor="#08ffffff"
                        android:angle="270" />
                    <corners android:radius="0dp" />
                    <stroke android:width="1dp" android:color="#40ffffff" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape>
                    <gradient
                        android:type="radial"
                        android:gradientRadius="120dp"
                        android:startColor="#0d66c0ff"
                        android:endColor="#0066c0ff" />
                    <corners android:radius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
