<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base frosted glass layer -->
    <item>
        <shape>
            <solid android:color="#18ffffff" />
            <stroke android:width="1.5dp" android:color="#50ffffff" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Subtle inner glow -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#08ffffff"
                android:endColor="#00ffffff" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
